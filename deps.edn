{:paths ["src"]

 :deps
 {http-kit/http-kit                   {:mvn/version "2.9.0-beta1"}
  org.babashka/json                   {:mvn/version "0.1.6"}
  metosin/malli                       {:mvn/version "0.20.0"}
  djblue/portal                       {:mvn/version "0.62.0"}
  com.github.seancorfield/honeysql    {:mvn/version "2.7.1350"}
  camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
  datascript/datascript               {:mvn/version "1.5.4"}
  metosin/reitit                      {:mvn/version "0.7.2"}
  org.clojure/test.check              {:mvn/version "1.1.1"}
  org.clojure/core.async              {:mvn/version "1.8.741"}
  clj-commons/clj-yaml                {:mvn/version "1.0.29"}}

 :aliases
 {:cljs
  {:extra-paths ["test"]
   :extra-deps
   {reagent/reagent           {:mvn/version "2.0.1"}
    re-frame/re-frame         {:mvn/version "1.4.3"}
    day8.re-frame/test        {:mvn/version "0.1.7"}
    com.cognitect/transit-cljs {:mvn/version "0.8.280"}
    binaryage/devtools        {:mvn/version "1.0.7"}
    thheller/shadow-cljs      {:mvn/version "3.3.2"}}}

  :shadow-cljs
  {:extra-deps {thheller/shadow-cljs {:mvn/version "3.3.2"}}
   :main-opts ["-m" "shadow.cljs.devtools.cli"]}

  :nrepl
  {:extra-deps {nrepl/nrepl       {:mvn/version "1.4.0"}
                cider/cider-nrepl {:mvn/version "0.58.0"}}
   :main-opts
   ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}}}
