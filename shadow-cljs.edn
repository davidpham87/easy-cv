{:deps {:aliases [:cljs]}

 :dev-http
 {8080 {:root "public"
        :headers {"Cross-Origin-Opener-Policy" "same-origin"
                  "Cross-Origin-Embedder-Policy" "require-corp"}}}

 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :js-options
   {:resolve
    {"@sqlite.org/sqlite-wasm"
     {:target :file
      :file
      "node_modules/@sqlite.org/sqlite-wasm/sqlite-wasm/jswasm/sqlite3.js"}}}
   :devtools {:autobuild true
              :after-load easy-cv.ui.core/reload!
              :preload [devtools.preload]}
   :modules {:shared             {:entries []}
             :main               {:init-fn easy-cv.ui.core/init
                                  :depends-on #{:shared}}
             :persistence-worker {:init-fn easy-cv.workers.persistence/init
                                  :depends-on #{:shared}
                                  :web-worker true}
             :compute-worker     {:init-fn easy-cv.workers.compute/init
                                  :depends-on #{:shared}
                                  :web-worker true}}}

  :test
  {:target :node-test
   :output-to "target/node-tests.js"
   :ns-regexp "easy-cv\\..*-test$"
   :autorun true}

  :e2e
  {:target :node-test
   :output-to "target/e2e-tests.js"
   :ns-regexp "e2e\\..*-test$"
   :autorun true}}}
