{
  "name": "easy-cv",
  "version": "0.1.0",
  "description": "Local-first ClojureScript CV fact archive and renderer",
  "private": true,
  "scripts": {
    "assets:copy": "mkdir -p public/js && cp node_modules/@sqlite.org/sqlite-wasm/sqlite-wasm/jswasm/sqlite3.wasm node_modules/@sqlite.org/sqlite-wasm/sqlite-wasm/jswasm/sqlite3-opfs-async-proxy.js public/js/",
    "latex:assets": "npx texlyre-busytex download-assets ./public/core",
    "postinstall": "npm run assets:copy",
    "css:build": "tailwindcss -i public/css/input.css -o public/css/app.css",
    "css:watch": "npm run css:build -- --watch",
    "dev": "npm run assets:copy && shadow-cljs watch app",
    "release": "npm run assets:copy && npm run css:build && shadow-cljs release app",
    "test:e2e": "npm run assets:copy && npm run css:build && shadow-cljs compile app e2e"
  },
  "dependencies": {
    "@citation-js/core": "^0.7.18",
    "@citation-js/plugin-bibtex": "^0.7.18",
    "@react-pdf/renderer": "^4.9.0",
    "@sqlite.org/sqlite-wasm": "^3.51.1-build1",
    "create-react-class": "^15.7.0",
    "js-yaml": "^4.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "texlyre-busytex": "^1.4.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "playwright": "^1.65.1",
    "shadow-cljs": "^3.3.2",
    "tailwindcss": "^4.0.0"
  }
}
